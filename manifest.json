{
  "manifest_version": 3,
  "name": "Xade Auth",
  "version": "1.0",
  "description": "Xade Authentication Extension for X/Twitter Integration",
  "permissions": ["cookies", "tabs", "scripting"],
  "action": {
    "default_icon": "icon.png",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "host_permissions": [
    "https://*.twitter.com/",
    "https://*.x.com/",
    "https://*.soundcloud.com/",
    "https://*.discord.com/",
    "https://*.twitch.tv/"
  ]
}
